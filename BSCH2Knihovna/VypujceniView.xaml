<Window x:Class="BSCH2Knihovna.VypujceniView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Správa Výpůjček" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox Width="200" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding FilteredVypujceniList}" 
              SelectedItem="{Binding SelectedVypujceni}" 
              AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Book Name" Binding="{Binding BookName}" Width="*" />
                    <DataGridTextColumn Header="Reader Name" Binding="{Binding CtenarName}" Width="*" />
                    <DataGridTextColumn Header="Loan Date" Binding="{Binding DatumVypujceni}" Width="*" />
                    <DataGridTextColumn Header="Return Due Date" Binding="{Binding DatumVratenka}" Width="*" />
                    <DataGridTextColumn Header="Actual Return Date" Binding="{Binding DatumVratu}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">

            <StackPanel Margin="3">
                <TextBlock Text="Book" Margin="0,0,0,2" />
                <ComboBox ItemsSource="{Binding KnihyList}" 
                  DisplayMemberPath="Nazev" 
                  SelectedValuePath="Id"
                  SelectedValue="{Binding EditingVypujceni.KnihaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  Width="100" />
            </StackPanel>

            <StackPanel Margin="3">
                <TextBlock Text="Reader" Margin="0,0,0,2" />
                <ComboBox ItemsSource="{Binding CtenariList}" 
                  DisplayMemberPath="Jmeno" 
                  SelectedValuePath="Id"
                  SelectedValue="{Binding EditingVypujceni.CtenarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  Width="100" />
            </StackPanel>

            <StackPanel Margin="3">
                <TextBlock Text="Return Due Date" Margin="0,0,0,2" />
                <DatePicker SelectedDate="{Binding EditingVypujceni.DatumVratenka, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    Width="120" />
            </StackPanel>

            <StackPanel Margin="3">
                <TextBlock Text="Actual Return Date" Margin="0,0,0,2" />
                <DatePicker SelectedDate="{Binding EditingVypujceni.DatumVratu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    Width="120" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="3">
                <Button Content="Add" Command="{Binding AddVypujceniCommand}" Width="60" Margin="2"/>
                <Button Content="Update" Command="{Binding UpdateVypujceniCommand}" Width="60" Margin="2"/>
                <Button Content="Delete" Command="{Binding DeleteVypujceniCommand}" Width="60" Margin="2"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
