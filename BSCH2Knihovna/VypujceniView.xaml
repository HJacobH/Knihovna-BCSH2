<Window x:Class="BSCH2Knihovna.VypujceniView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Správa Výpůjček" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding VypujceniList}" SelectedItem="{Binding SelectedVypujceni}" 
          AutoGenerateColumns="False" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Kniha ID" Binding="{Binding KnihaId}" />
                <DataGridTextColumn Header="Čtenář ID" Binding="{Binding CtenarId}" />
                <DataGridTextColumn Header="Datum Výpůjčky" Binding="{Binding DatumVypujceni}" />
                <DataGridTextColumn Header="Datum Vrácení" Binding="{Binding DatumVratenka}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding KnihyList}" 
              DisplayMemberPath="Nazev" 
              SelectedValuePath="Id"
              SelectedValue="{Binding EditingVypujceni.KnihaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox ItemsSource="{Binding CtenariList}" 
              DisplayMemberPath="Jmeno" 
              SelectedValuePath="Id"
              SelectedValue="{Binding EditingVypujceni.CtenarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="Add" Command="{Binding AddVypujceniCommand}" Width="75" Margin="5"/>
            <Button Content="Update" Command="{Binding UpdateVypujceniCommand}" Width="75" Margin="5"/>
            <Button Content="Delete" Command="{Binding DeleteVypujceniCommand}" Width="75" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
