<Window x:Class="BSCH2Knihovna.SekceKnihovny"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Section Management" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="200" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FilteredSekceList}" 
                  SelectedItem="{Binding SelectedSekce}" AutoGenerateColumns="False" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Room" Binding="{Binding Mistnost}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Kategorie}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Popis}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
            <TextBlock Text="Room:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Width="200" Text="{Binding EditingSekce.Mistnost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Category:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Width="200" ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding EditingSekce.Kategorie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Width="200" Text="{Binding EditingSekce.Popis, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Add" Command="{Binding AddSekceCommand}" Width="60" Margin="5,0"/>
                <Button Content="Update" Command="{Binding UpdateSekceCommand}" Width="60" Margin="5,0"/>
                <Button Content="Delete" Command="{Binding DeleteSekceCommand}" Width="60" Margin="5,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Books in this Section:" FontWeight="Bold" Grid.Row="2" Grid.Column="0" Margin="10,10,0,5"/>
        <DataGrid Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedSekce.Knihy}" 
                  AutoGenerateColumns="False" Height="150" Margin="10,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="*"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Nazev}" Width="*"/>
                <DataGridTextColumn Header="Author" Binding="{Binding Autor}" Width="*"/>
                <DataGridTextColumn Header="Year of Publication" Binding="{Binding RokVydani}" Width="*"/>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Nakladatelstvi}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
