<Window x:Class="BSCH2Knihovna.SekceKnihovny"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BSCH2Knihovna"
        mc:Ignorable="d"
        Title="Správa Sekcí" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" Grid.Column="0" ItemsSource="{Binding SekceList}" 
          SelectedItem="{Binding SelectedSekce}" AutoGenerateColumns="False" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Místnost" Binding="{Binding Mistnost}" Width="*"/>
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="*"/>
                <DataGridTextColumn Header="Popis" Binding="{Binding Popis}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
            <TextBlock Text="Místnost:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Width="200" Text="{Binding EditingSekce.Mistnost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Kategorie:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding EditingSekce.Kategorie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Popis:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Width="200" Text="{Binding EditingSekce.Popis, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Add" Command="{Binding AddSekceCommand}" Width="60" Margin="5,0"/>
                <Button Content="Update" Command="{Binding UpdateSekceCommand}" Width="60" Margin="5,0"/>
                <Button Content="Delete" Command="{Binding DeleteSekceCommand}" Width="60" Margin="5,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Books in this Section:" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="10,10,0,5"/>

        <DataGrid Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedSekce.Knihy}" AutoGenerateColumns="False" Height="200" Margin="10,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="*"/>
                <DataGridTextColumn Header="Název" Binding="{Binding Nazev}" Width="*"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="*"/>
                <DataGridTextColumn Header="Rok Vydání" Binding="{Binding RokVydani}" Width="*"/>
                <DataGridTextColumn Header="Nakladatelství" Binding="{Binding Nakladatelstvi}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
